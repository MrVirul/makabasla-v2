# ==========================================
# Database URIs (Go/pgx standard format)
# Local Dockerized PostgreSQL (see compose.yaml, service "postgres").
# One database per service, created by scripts/init-databases.sh.
# ==========================================
WEBSTORE_DB_URL=postgres://postgres:postgres@postgres:5432/webstoredb?sslmode=disable
TSKMGT_DB_URL=postgres://postgres:postgres@postgres:5432/taskdb?sslmode=disable
APPOINTMENT_DB_URL=postgres://postgres:postgres@postgres:5432/appointmentdb?sslmode=disable
BILLING_DB_URL=postgres://postgres:postgres@postgres:5432/billingdb?sslmode=disable
IAM_DB_URL=postgres://postgres:postgres@postgres:5432/iamdb?sslmode=disable

# Host-side DSNs (use these when running services with `go run` on your machine)
# WEBSTORE_HONST_DB_URL=postgres://postgres:postgres@localhost:5432/webstoredb?sslmode=disable
# TSKMGT_HOST_DB_URL=postgres://postgres:postgres@localhost:5432/taskdb?sslmode=disable
# APPOINTMENT_HOST_DB_URL=postgres://postgres:postgres@localhost:5432/appointmentdb?sslmode=disable
# BILLING_HOST_DB_URL=postgres://postgres:postgres@localhost:5432/billingdb?sslmode=disable
# IAM_HOST_DB_URL=postgres://postgres:postgres@localhost:5432/iamdb?sslmode=disable

# ==========================================
# Google OAuth Credentials
# ==========================================
# Get these from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# ==========================================
# Service Discovery & Local Infrastructure
# ==========================================
CONSUL_HOST=consul

# Local DB Credentials (mapped in compose.yaml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres


NEXTAUTH_SECRET=replace-with-a-random-32-byte-secret
NEXTAUTH_URL=http://localhost:3000
